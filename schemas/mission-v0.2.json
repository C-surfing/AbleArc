{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/C-surfing/ai4learning/schemas/mission-v0.2.json",
  "title": "ai4learning mission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "status",
    "goal",
    "why",
    "source",
    "criteria",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "#/$defs/localId" },
    "project_id": { "$ref": "#/$defs/localId" },
    "status": { "enum": ["planned", "active", "completed", "superseded"] },
    "goal": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "why": { "type": "string", "maxLength": 2400 },
    "source": { "enum": ["learner-explicit", "agent-assisted", "imported"] },
    "criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "required", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "capability": { "type": "string", "minLength": 1, "maxLength": 500 },
        "required": { "type": "boolean" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
          "uniqueItems": true
        }
      }
    }
  }
}
