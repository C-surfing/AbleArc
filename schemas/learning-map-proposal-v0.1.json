{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4learning.local/schemas/learning-map-proposal-v0.1.json",
  "title": "LearningMapProposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "workspace_id",
    "project_id",
    "mission_id",
    "base_revision",
    "created_at",
    "proposed_by",
    "rationale",
    "evidence_ids",
    "frontier",
    "nodes",
    "edges",
    "delta"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "learning-map-proposal" },
    "id": { "type": "string", "pattern": "^mp_[A-Za-z0-9_-]{4,124}$" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "minLength": 1, "maxLength": 100 },
    "proposed_by": { "type": "string", "minLength": 1, "maxLength": 200 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "frontier": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "delta": { "$ref": "#/$defs/delta" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "mission_relevance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["concept", "procedure", "strategy"] },
        "mission_relevance": { "enum": ["core", "supporting", "optional"] }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "relation", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["prerequisite", "component", "prepares", "contrast", "transfer"] },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_node_ids",
        "removed_node_ids",
        "changed_node_ids",
        "added_edge_ids",
        "removed_edge_ids",
        "changed_edge_ids",
        "frontier_changed"
      ],
      "properties": {
        "added_node_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "removed_node_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "changed_node_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "added_edge_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "removed_edge_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "changed_edge_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "frontier_changed": { "type": "boolean" }
      }
    }
  }
}
