{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/C-surfing/ai4learning/schemas/workspace-v0.2.json",
  "title": "ai4learning workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "active_project_id",
    "onboarding",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "type": "string", "pattern": "^ws_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "active_project_id": {
      "oneOf": [
        { "$ref": "#/$defs/localId" },
        { "type": "null" }
      ]
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro_seen"],
      "properties": {
        "intro_seen": { "type": "boolean" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
