{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/C-surfing/ai4learning/schemas/runtime-v0.2.json",
  "title": "ai4learning project-scoped runtime receipt",
  "oneOf": [
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/frontierRevision"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/stateProposal"
    },
    {
      "$ref": "#/$defs/stateDecision"
    },
    {
      "$ref": "#/$defs/turn"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "id",
        "created_at",
        "workspace_id",
        "project_id",
        "mission_id"
      ],
      "properties": {
        "schema_version": {
          "const": "0.2"
        },
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 5
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^ws_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        "project_id": {
          "$ref": "#/$defs/localId"
        },
        "mission_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "masteryState": {
      "enum": [
        "unknown",
        "exposed",
        "developing",
        "stable",
        "transferable"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "mode",
            "target",
            "concept_ids",
            "frontier_hypothesis",
            "evidence_used",
            "uncertainty",
            "move",
            "rationale",
            "learner_action",
            "representation",
            "expected_evidence",
            "falsification_signal"
          ],
          "properties": {
            "kind": {
              "const": "decision"
            },
            "mode": {
              "enum": [
                "teach",
                "study"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "concept_ids": {
              "$ref": "#/$defs/stringList"
            },
            "frontier_hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "evidence_used": {
              "$ref": "#/$defs/stringList"
            },
            "uncertainty": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "move": {
              "enum": [
                "orient",
                "probe",
                "motivate",
                "establish_intuition",
                "name_or_formalize",
                "connect",
                "contrast",
                "derive",
                "worked_example",
                "prediction",
                "practice",
                "retrieve",
                "repair_misconception",
                "apply",
                "generalize",
                "transfer",
                "compress_or_reference"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "learner_action": {
              "type": "string",
              "minLength": 1
            },
            "representation": {
              "type": "object",
              "required": [
                "kind",
                "purpose"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "expected_evidence": {
              "type": "string",
              "minLength": 1
            },
            "falsification_signal": {
              "type": "string",
              "minLength": 1
            },
            "recorded_after_action": {
              "const": true
            },
            "late_record_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "observation": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "decision_id",
            "concept_ids",
            "learner_action",
            "observed_result",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "observation"
            },
            "decision_id": {
              "type": "string",
              "pattern": "^dec_"
            },
            "concept_ids": {
              "$ref": "#/$defs/stringList"
            },
            "learner_action": {
              "type": "string",
              "minLength": 1
            },
            "observed_result": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "learner",
                "tool",
                "assessor"
              ]
            },
            "excerpt": {
              "type": "string",
              "minLength": 1
            },
            "artifact_interaction": {
              "type": "object",
              "required": [
                "artifact_id",
                "prediction_id",
                "initial_prevalence",
                "final_prevalence"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^art_"
                },
                "prediction_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "initial_prevalence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "final_prevalence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    },
    "frontierRevision": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "supersedes_decision_id",
            "revised_by_decision_id",
            "previous_hypothesis",
            "revised_hypothesis",
            "evidence_ids",
            "reason",
            "rationale",
            "recorded_by"
          ],
          "properties": {
            "kind": {
              "const": "frontier-revision"
            },
            "supersedes_decision_id": {
              "type": "string",
              "pattern": "^dec_"
            },
            "revised_by_decision_id": {
              "type": "string",
              "pattern": "^dec_"
            },
            "previous_hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "revised_hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "$ref": "#/$defs/stringList"
            },
            "reason": {
              "enum": [
                "prerequisite_discovered",
                "hypothesis_refuted",
                "scope_refined"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "observation_id",
            "concept_ids",
            "level",
            "outcome",
            "failure_mode",
            "artifact_form",
            "result_summary",
            "scaffolding",
            "context",
            "delay",
            "independence",
            "supports",
            "contradicts",
            "confidence",
            "assessor"
          ],
          "properties": {
            "kind": {
              "const": "evidence"
            },
            "observation_id": {
              "type": "string",
              "pattern": "^obs_"
            },
            "concept_ids": {
              "$ref": "#/$defs/stringList"
            },
            "level": {
              "enum": [
                "recognition",
                "recall",
                "explanation",
                "application",
                "transfer"
              ]
            },
            "outcome": {
              "enum": [
                "supports",
                "contradicts",
                "inconclusive"
              ]
            },
            "failure_mode": {
              "enum": [
                "none",
                "slip",
                "missing_prerequisite",
                "vocabulary_confusion",
                "local_procedural_gap",
                "wrong_causal_model",
                "overgeneralization",
                "failed_transfer"
              ]
            },
            "artifact_form": {
              "enum": [
                "prose",
                "pseudocode",
                "code",
                "executed_code",
                "diagram"
              ]
            },
            "result_summary": {
              "type": "string",
              "minLength": 1
            },
            "scaffolding": {
              "enum": [
                "none",
                "light",
                "heavy"
              ]
            },
            "context": {
              "enum": [
                "same",
                "varied",
                "novel"
              ]
            },
            "delay": {
              "enum": [
                "immediate",
                "delayed"
              ]
            },
            "independence": {
              "enum": [
                "same_form",
                "new_form",
                "independent"
              ]
            },
            "supports": {
              "$ref": "#/$defs/stringList"
            },
            "contradicts": {
              "$ref": "#/$defs/stringList"
            },
            "confidence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "assessor": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "supports"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "failure_mode": {
                    "const": "none"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "contradicts"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "failure_mode": {
                    "not": {
                      "const": "none"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "stateProposal": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "concept_id",
            "concept_label",
            "before",
            "after",
            "evidence_ids",
            "rationale",
            "proposed_by"
          ],
          "properties": {
            "kind": {
              "const": "state-proposal"
            },
            "concept_id": {
              "type": "string",
              "minLength": 1
            },
            "concept_label": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "$ref": "#/$defs/masteryState"
            },
            "after": {
              "$ref": "#/$defs/masteryState"
            },
            "evidence_ids": {
              "$ref": "#/$defs/stringList"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "proposed_by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "stateDecision": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "proposal_id",
            "decision",
            "authority",
            "reason",
            "policy_issues",
            "policy_overridden"
          ],
          "properties": {
            "kind": {
              "const": "state-decision"
            },
            "proposal_id": {
              "type": "string",
              "pattern": "^sp_"
            },
            "decision": {
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "authority": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "learner",
                    "human_reviewer",
                    "runtime_policy"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "projection_revision": {
              "type": "integer",
              "minimum": 1
            },
            "policy_issues": {
              "$ref": "#/$defs/stringList"
            },
            "policy_overridden": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "turn": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "decision_id",
            "observation_ids",
            "evidence_ids",
            "state_proposal_ids",
            "state_decision_ids",
            "artifact_refs",
            "outcome",
            "summary"
          ],
          "properties": {
            "kind": {
              "const": "turn"
            },
            "decision_id": {
              "type": "string",
              "pattern": "^dec_"
            },
            "observation_ids": {
              "$ref": "#/$defs/stringList"
            },
            "evidence_ids": {
              "$ref": "#/$defs/stringList"
            },
            "state_proposal_ids": {
              "$ref": "#/$defs/stringList"
            },
            "state_decision_ids": {
              "$ref": "#/$defs/stringList"
            },
            "artifact_refs": {
              "$ref": "#/$defs/stringList"
            },
            "outcome": {
              "enum": [
                "completed",
                "awaiting_evidence",
                "abandoned"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "model",
                "attempt_count",
                "duration_ms"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "attempt_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600000
                }
              }
            },
            "superseded_by_decision_id": {
              "type": "string",
              "pattern": "^dec_"
            }
          }
        }
      ]
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
