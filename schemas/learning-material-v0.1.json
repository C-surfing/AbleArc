{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/C-surfing/ai4learning/schemas/learning-material-v0.1.json",
  "title": "ai4learning saved LearningMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "workspace_id",
    "project_id",
    "mission_id",
    "material_type",
    "title",
    "summary",
    "why_return",
    "body_markdown",
    "concept_ids",
    "evidence_ids",
    "source_refs",
    "tags",
    "created_at"
  ],
  "anyOf": [
    {
      "properties": {
        "evidence_ids": { "minItems": 1 }
      }
    },
    {
      "properties": {
        "source_refs": { "minItems": 1 }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "material_type": {
            "enum": ["misconception_note", "feynman_explanation"]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ids": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "material_type": { "const": "source_note" }
        }
      },
      "then": {
        "properties": {
          "source_refs": { "minItems": 1 }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "learning-material" },
    "id": { "type": "string", "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "workspace_id": { "type": "string", "pattern": "^ws_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "project_id": { "$ref": "#/$defs/localId" },
    "mission_id": { "$ref": "#/$defs/localId" },
    "material_type": {
      "enum": [
        "concept_note",
        "derivation",
        "worked_example",
        "formula_sheet",
        "code_artifact",
        "diagram",
        "misconception_note",
        "source_note",
        "feynman_explanation"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "why_return": { "type": "string", "minLength": 1, "maxLength": 800 },
    "body_markdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "concept_ids": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/localId" },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
