{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4learning.local/schemas/learning-material-curation-v0.1.json",
  "title": "Learning Material Curation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "workspace_id",
    "project_id",
    "revision",
    "selected_material_ids",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "learning-material-curation" },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "selected_material_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
