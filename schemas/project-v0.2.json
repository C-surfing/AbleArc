{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/C-surfing/ai4learning/schemas/project-v0.2.json",
  "title": "ai4learning project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "active_mission_id",
    "maintenance_status",
    "created_at",
    "updated_at",
    "archived_at"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "#/$defs/localId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["active", "paused", "archived"] },
    "active_mission_id": {
      "oneOf": [
        { "$ref": "#/$defs/localId" },
        { "type": "null" }
      ]
    },
    "maintenance_status": { "enum": ["none", "scheduled", "due", "study_active"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "archived_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    }
  }
}
