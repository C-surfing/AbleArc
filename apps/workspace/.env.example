# Optional deployment/developer override for Provider configuration.
# Normal local Web users configure the model in the graphical /settings flow.
# Never expose these values with NEXT_PUBLIC_. Environment credentials take precedence over Web settings.
# AbleArc variables are preferred. AI4LEARNING_* remains a compatibility alias during migration.
ABLEARC_PROVIDER_API_KEY=
ABLEARC_PROVIDER_MODEL=
ABLEARC_PROVIDER_BASE_URL=https://api.openai.com/v1
# json_schema is the safest default. Use json_object for compatible endpoints that do not
# support JSON Schema response_format on /chat/completions.
ABLEARC_PROVIDER_STRUCTURED_OUTPUT=json_schema
ABLEARC_PROVIDER_TIMEOUT_MS=45000

# Optional bearer token for external ChatGPT/assistant host calls to /api/host/learning.
# Use a strong random secret and HTTPS when exposing the endpoint beyond localhost.
ABLEARC_HOST_TOKEN=
